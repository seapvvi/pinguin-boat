// ─── Générateur & Source de données ───

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Énumérations ───

/// Types d'événements de logs disponibles
enum LogEventType {
  MESSAGE_DELETE
  MESSAGE_EDIT
  MEMBER_JOIN
  MEMBER_LEAVE
  MEMBER_BAN
  MEMBER_UNBAN
  MEMBER_KICK
  MEMBER_TIMEOUT
  MEMBER_ROLE_ADD
  MEMBER_ROLE_REMOVE
  CHANNEL_CREATE
  CHANNEL_DELETE
  CHANNEL_UPDATE
  ROLE_CREATE
  ROLE_DELETE
  ROLE_UPDATE
  VOICE_JOIN
  VOICE_LEAVE
  VOICE_MOVE
  EMOJI_CREATE
  EMOJI_DELETE
  INVITE_CREATE
  INVITE_DELETE
  THREAD_CREATE
  THREAD_DELETE
  THREAD_UPDATE
  STAGE_START
  STAGE_END
  AUTO_MOD
  MEMBER_WARN
  MEMBER_MUTE
  MEMBER_UNMUTE
}

/// Préférences de notification de level up
enum LevelUpNotification {
  DM
  CHANNEL
  NONE
}

/// Types de sanctions de modération
enum ModerationCaseType {
  WARN
  MUTE
  UNMUTE
  KICK
  BAN
  TEMPBAN
  UNBAN
  TIMEOUT
}

/// Statut d'un ticket
enum TicketStatus {
  OPEN
  CLAIMED
  PENDING
  CLOSED
  DELETED
}

/// Statut de déploiement
enum DeploymentStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  ROLLED_BACK
}

/// Environnement cible d'un déploiement
enum DeployEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

/// Type de rôle automatique
enum AutoroleType {
  JOIN
  BOT
  LEVEL
  REACTION
}

/// Type de transaction économique
enum TransactionType {
  DAILY
  TRANSFER
  SHOP_BUY
  GAMBLE
  ADMIN
  EARN
  INTEREST
}

/// Type d'item de boutique
enum ItemType {
  ROLE
  XP_BOOST
  ANTI_THEFT
  LOTTO_TICKET
}

/// Type de quête
enum QuestType {
  DAILY
  WEEKLY
}

/// Statut d'une quête
enum QuestStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

/// Type d'objectif de quête
enum QuestObjectiveType {
  SEND_MESSAGES
  WIN_BLACKJACK
  WIN_ROULETTE
  EARN_MONEY
  USE_COMMAND
  LEVEL_UP
}

/// Statut d'un giveaway
enum GiveawayStatus {
  RUNNING
  ENDED
  CANCELLED
}

/// Statut d'un sondage
enum PollStatus {
  OPEN
  CLOSED
}

/// Statut d'une suggestion
enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
  IMPLEMENTED
}

/// Mode de boucle musicale
enum LoopMode {
  NONE
  TRACK
  QUEUE
}

/// Statut d'abonnement premium
enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

/// Actions auditées
enum AuditAction {
  GUILD_UPDATE
  GUILD_DELETE
  MEMBER_KICK
  MEMBER_BAN
  MEMBER_UNBAN
  MEMBER_TIMEOUT
  MEMBER_WARN
  MEMBER_MUTE
  MEMBER_UNMUTE
  TICKET_CREATE
  TICKET_CLOSE
  TICKET_DELETE
  MESSAGE_CREATE
  MESSAGE_PURGE
  ROLE_CREATE
  ROLE_DELETE
  ROLE_UPDATE
  CHANNEL_CREATE
  CHANNEL_DELETE
  CHANNEL_UPDATE
  SETTINGS_UPDATE
  PREMIUM_UPDATE
  ECONOMY_ADMIN
  PLUGIN_ENABLE
  PLUGIN_DISABLE
  BLACKLIST_ADD
  BLACKLIST_REMOVE
  BLACKLIST_USER
  UNBLACKLIST_USER
  BLACKLIST_GUILD
  UNBLACKLIST_GUILD
  FORCE_LEAVE
  DEPLOYMENT_START
  DEPLOYMENT_SUCCESS
  DEPLOYMENT_FAILURE
  DEPLOYMENT_ROLLBACK
  PREMIUM_GRANT
  PREMIUM_REVOKE
  ALPHA_MODE_TOGGLE
  CHANGELOG_PUBLISH
  GLOBAL_ANNOUNCEMENT
  SERVICE_RESTART
  BACKUP_CREATED
  BACKUP_RESTORED
  SETTINGS_CHANGE
  OWNER_LOGIN
  OWNER_LOGOUT
  MODERATION_CASE_DELETED
  MODERATION_CASE_REVOKED
  AUTO_MOD_VIOLATION
  AUTO_MOD_SANCTION
}

// ─── Modèles ───

/// Utilisateur du bot
model User {
  id              String   @id @default(cuid()) @map("id")
  discordId       String   @unique @map("discord_id")
  username        String   @map("username")
  displayName     String?  @map("display_name")
  avatar          String?  @map("avatar")
  email           String?  @map("email")
  locale          String   @default("fr") @map("locale")
  theme           String   @default("DARK") @map("theme")
  snowflakes      Boolean  @default(true) @map("snowflakes")
  notifyDaily     Boolean  @default(false) @map("notify_daily")
  notifyWeekly    Boolean  @default(false) @map("notify_weekly")

  premiumSubscription PremiumSubscription?

  economyGuilds   EconomyWallet[]
  xpProfiles      XPProfile[]
  moderationCases ModerationCase[]
  ticketsCreated  Ticket[]       @relation("TicketCreator")
  ticketClaims    TicketClaim[]
  claimedTickets  Ticket[]       @relation("TicketClaims")
  suggestions     Suggestion[]
  pollVotes       PollVote[]
  giveawayEntries GiveawayEntry[]
  auditLogs       AuditLog[]
  ownerLogs       OwnerLog[]
  sessions        Session[]
  owner2FA        Owner2FA?
  changelogs      Changelog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

/// Session de connexion
model Session {
  id                    String    @id @map("id")
  userId                String    @map("user_id")
  guildId               String?   @map("guild_id")
  token                 String    @unique @map("token")
  discordAccessToken    String?   @map("discord_access_token")
  discordRefreshToken   String?   @map("discord_refresh_token")
  discordTokenExpiresAt DateTime? @map("discord_token_expires_at")
  expiresAt             DateTime  @map("expires_at")
  ownerVerifiedAt       DateTime? @map("owner_verified_at")
  owner2faVerifiedAt    DateTime? @map("owner_2fa_verified_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

/// Authentification à deux facteurs pour les propriétaires
model Owner2FA {
  id            String    @id @default(cuid()) @map("id")
  userId        String    @unique @map("user_id")
  secret        String    @map("secret")
  enabled       Boolean   @default(false) @map("enabled")
  verified      Boolean   @default(false) @map("verified")
  lastVerifiedAt DateTime? @map("last_verified_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("owner_2fa")
}

/// Hash du mot de passe owner (stocké en base, jamais en clair)
model OwnerPassword {
  id        String   @id @default(cuid()) @map("id")
  hash      String   @map("hash")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("owner_password")
}

/// Serveur Discord
model Guild {
  id          String  @id @map("id")
  name        String  @map("name")
  icon        String? @map("icon")
  ownerId     String? @map("owner_id")
  memberCount Int     @default(0) @map("member_count")
  botPresent  Boolean @default(true) @map("bot_present")

  settings        GuildSettings?
  modulesEnabled  ModuleEnabled?
  logSettings     LogSettings?
  xpSettings      XPSettings?
  welcomeSettings WelcomeSettings?
  economySettings EconomySettings?
  protectionSettings ProtectionSettings?
  autoroleSettings AutoroleSettings?
  autoModSettings  AutoModSettings?
  ticketSettings   TicketSettings?
  musicQueues     MusicQueue?
  musicSettings   MusicSettings?
  blacklist       BlacklistGuild?
  premiumSubscription PremiumSubscription?
  minigameSettings MinigameSettings?
  starboardSettings StarboardSettings?
  formSettings    FormSettings?

  moderationCases  ModerationCase[]
  tickets          Ticket[]
  ticketCategories TicketCategory[]
  xpProfiles       XPProfile[]
  xpRoleRewards    XPRoleReward[]
  rankCardSettings RankCardSettings?
  economyWallets   EconomyWallet[]
  economyTransactions EconomyTransaction[]
  quests           Quest[]
  questProgress    QuestProgress[]
  musicHistory     MusicHistoryEntry[]
  giveaways        Giveaway[]
  polls            Poll[]
  suggestions      Suggestion[]
  autoroleEntries  AutoroleEntry[]
  savedEmbeds      SavedEmbed[]
  guildMembers     GuildMember[]
  auditLogs        AuditLog[]
  clans            Clan[]
  clanMembers      ClanMember[]
  clanWars         ClanWar[]
  streamNotifications StreamNotification[]
  guildBackups    GuildBackup[]
  guildBlacklistUsers GuildBlacklistUser[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("guilds")
}

/// Configuration du module musical
model MusicSettings {
  id                    String   @id @default(cuid()) @map("id")
  guildId               String   @unique @map("guild_id")
  enabled               Boolean  @default(true) @map("enabled")
  maxQueueLength        Int      @default(50) @map("max_queue_length")
  maxPlaylistLength     Int      @default(50) @map("max_playlist_length")
  defaultVolume         Int      @default(50) @map("default_volume")
  allowDjRole           Boolean  @default(false) @map("allow_dj_role")
  djRoleId              String?  @map("dj_role_id")
  restrictToVoiceChannel Boolean @default(false) @map("restrict_to_voice_channel")
  voiceChannelId        String?  @map("voice_channel_id")
  announceTracks        Boolean  @default(true) @map("announce_tracks")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  guild     Guild      @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("music_settings")
}

/// Configuration générale d'un serveur
model GuildSettings {
  id           String   @id @default(cuid()) @map("id")
  guildId      String   @unique @map("guild_id")
  prefix       String?  @map("prefix")
  locale       String   @default("fr") @map("locale")
  timezone     String   @default("Europe/Paris") @map("timezone")
  modLogChannel String? @map("mod_log_channel")
  modRoleIds   String   @default("[]") @map("mod_role_ids")
  adminRoleIds String   @default("[]") @map("admin_role_ids")
  muteRoleId   String?  @map("mute_role_id")
  dashboardAccessRoles String @default("[]") @map("dashboard_access_roles")
  dashboardModerationAccess String @default("[]") @map("dashboard_moderation_access")
  dashboardTicketsAccess String @default("[]") @map("dashboard_tickets_access")
  dashboardPollsAccess String @default("[]") @map("dashboard_polls_access")
  dashboardSuggestionsAccess String @default("[]") @map("dashboard_suggestions_access")
  dashboardGiveawaysAccess String @default("[]") @map("dashboard_giveaways_access")
  dashboardEconomyAccess String @default("[]") @map("dashboard_economy_access")
  dashboardMusicAccess String @default("[]") @map("dashboard_music_access")
  dashboardLevelsAccess String @default("[]") @map("dashboard_levels_access")
  dashboardWelcomeAccess String @default("[]") @map("dashboard_welcome_access")
  dashboardAutorolesAccess String @default("[]") @map("dashboard_autoroles_access")
  dashboardLogsAccess String @default("[]") @map("dashboard_logs_access")
  dashboardProtectionAccess String @default("[]") @map("dashboard_protection_access")
  dashboardAuditAccess String @default("[]") @map("dashboard_audit_access")
  changelogChannel String? @map("changelog_channel")
  suggestionChannelId String? @map("suggestion_channel_id")
  onboardingDone Boolean @default(false) @map("onboarding_done")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  guild Guild @relation(fields: [guildId], references: [id])

  @@map("guild_settings")
}

/// Source de découverte lors de l'onboarding
model OnboardingSource {
  id        String   @id @default(cuid()) @map("id")
  guildId   String   @map("guild_id")
  source    String   @map("source")
  details   String?  @map("details")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([source])
  @@index([createdAt])
  @@map("onboarding_sources")
}

/// Modules activés ou désactivés sur un serveur
model ModuleEnabled {
  id          String   @id @default(cuid()) @map("id")
  guildId     String   @unique @map("guild_id")

  moderation  Boolean  @default(true) @map("moderation")
  protection  Boolean  @default(true) @map("protection")
  tickets     Boolean  @default(true) @map("tickets")
  logs        Boolean  @default(true) @map("logs")
  levels      Boolean  @default(true) @map("levels")
  economy     Boolean  @default(false) @map("economy")
  music       Boolean  @default(true) @map("music")
  giveaways   Boolean  @default(true) @map("giveaways")
  polls       Boolean  @default(true) @map("polls")
  suggestions Boolean  @default(true) @map("suggestions")
  welcome     Boolean  @default(true) @map("welcome")
  autoroles   Boolean  @default(true) @map("autoroles")
  embeds      Boolean  @default(true) @map("embeds")
  minigames   Boolean  @default(true) @map("minigames")
  starboard   Boolean  @default(false) @map("starboard")
  forms       Boolean  @default(false) @map("forms")
  clans       Boolean  @default(false) @map("clans")
  notifications Boolean @default(false) @map("notifications")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  guild Guild @relation(fields: [guildId], references: [id])

  @@map("modules_enabled")
}

/// Plateforme de streaming
enum StreamPlatform {
  TWITCH
  YOUTUBE

  @@map("stream_platform")
}

/// Notification de live Twitch/YouTube configurée sur un serveur
model StreamNotification {
  id                 String         @id @default(cuid()) @map("id")
  guildId            String         @map("guild_id")
  platform           StreamPlatform @map("platform")
  channelName        String         @map("channel_name")
  channelId          String?        @map("channel_id")
  discordChannelId   String         @map("discord_channel_id")
  lastLiveAt         DateTime?      @map("last_live_at")
  isLive             Boolean        @default(false) @map("is_live")
  lastVideoId        String?        @map("last_video_id")
  lastLiveId         String?        @map("last_live_id")
  customTitle        String?        @map("custom_title")
  customDescription  String?        @map("custom_description")
  customColor        String?        @map("custom_color")
  customFooter       String?        @map("custom_footer")
  mentionRoleId      String?        @map("mention_role_id")
  pingEveryoneOnLive Boolean        @default(false) @map("ping_everyone_on_live")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  guild Guild @relation(fields: [guildId], references: [id])

  @@unique([guildId, platform, channelName])
  @@map("stream_notifications")
}

/// Cas de modération
model ModerationCase {
  id           String   @id @default(cuid()) @map("id")
  guildId      String   @map("guild_id")
  userId       String   @map("user_id")
  moderatorId  String   @map("moderator_id")
  type         ModerationCaseType @map("type")
  reason       String   @map("reason")
  duration     Int?     @map("duration")
  expiresAt    DateTime? @map("expires_at")
  active       Boolean  @default(true) @map("active")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  guild Guild @relation(fields: [guildId], references: [id])
  user  User  @relation(fields: [userId], references: [discordId])

  @@index([guildId, userId])
  @@index([guildId, moderatorId])
  @@index([guildId, createdAt])
  @@map("moderation_cases")
}

/// Avertissements indépendants des cas de modération
model Warning {
  id           String   @id @default(cuid()) @map("id")
  guildId      String   @map("guild_id")
  userId       String   @map("user_id")
  moderatorId  String   @map("moderator_id")
  reason       String   @map("reason")
  active       Boolean  @default(true) @map("active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([guildId, userId])
  @@map("warnings")
}

/// Ticket de support
model Ticket {
  id          String       @id @default(cuid()) @map("id")
  guildId     String       @map("guild_id")
  channelId   String       @unique @map("channel_id")
  creatorId   String       @map("creator_id")
  categoryId  String?      @map("category_id")
  subject     String       @map("subject")
  description String?      @map("description")
  status      TicketStatus @default(OPEN) @map("status")
  claimedById String?      @map("claimed_by_id")
  closedById  String?      @map("closed_by_id")
  closedAt    DateTime?    @map("closed_at")
  transcriptId String?     @map("transcript_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  guild    Guild           @relation(fields: [guildId], references: [id])
  creator  User            @relation("TicketCreator", fields: [creatorId], references: [discordId])
  category TicketCategory? @relation(fields: [categoryId], references: [id])
  claimedBy User?          @relation("TicketClaims", fields: [claimedById], references: [discordId])
  claims   TicketClaim[]

  @@index([guildId, status])
  @@index([guildId, creatorId])
  @@map("tickets")
}

/// Réclamation d'un ticket par un membre du staff
model TicketClaim {
  id        String   @id @default(cuid()) @map("id")
  ticketId  String   @map("ticket_id")
  userId    String   @map("user_id")
  claimedAt DateTime @default(now()) @map("claimed_at")

  ticket Ticket @relation(fields: [ticketId], references: [id])
  user  User  @relation(fields: [userId], references: [discordId])

  @@unique([ticketId, userId])
  @@map("ticket_claims")
}

/// Catégorie de ticket
model TicketCategory {
  id               String   @id @default(cuid()) @map("id")
  guildId          String   @map("guild_id")
  name             String   @map("name")
  description      String?  @map("description")
  staffRoleIds     String   @default("[]") @map("staff_role_ids")
  maxTicketsPerUser Int     @default(5) @map("max_tickets_per_user")
  openingMode      String   @default("BUTTON") @map("opening_mode")
  formId           String?  @map("form_id")
  welcomeMessage   String?  @map("welcome_message")
  color            String   @default("#5865F2") @map("color")
  emoji            String?  @map("emoji")
  position         Int      @default(0) @map("position")
  createdAt        DateTime @default(now()) @map("created_at")

  guild   Guild   @relation(fields: [guildId], references: [id])
  tickets Ticket[]

  @@index([guildId])
  @@map("ticket_categories")
}

/// Métadonnées de transcription de ticket
model TranscriptMeta {
  id        String   @id @default(cuid()) @map("id")
  ticketId  String   @unique @map("ticket_id")
  channelId String   @map("channel_id")
  guildId   String   @map("guild_id")
  fileUrl   String?  @map("file_url")
  content   String?  @map("content")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("transcript_metas")
}

/// Configuration des logs d'audit
model LogSettings {
  id              String   @id @default(cuid()) @map("id")
  guildId         String   @unique @map("guild_id")
  logChannelId    String?  @map("log_channel_id")
  events          String   @default("[]") @map("events")
  ignoredChannels String   @default("[]") @map("ignored_channels")
  ignoredRoles    String   @default("[]") @map("ignored_roles")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  guild Guild @relation(fields: [guildId], references: [id])

  @@map("log_settings")
}

/// Configuration du système d'XP et niveaux
model XPSettings {
  id                  String   @id @default(cuid()) @map("id")
  guildId             String   @unique @map("guild_id")
  enabled             Boolean  @default(true) @map("enabled")
  xpPerMessageMin     Int      @default(15) @map("xp_per_message_min")
  xpPerMessageMax     Int      @default(25) @map("xp_per_message_max")
  voiceXp             Int      @default(10) @map("voice_xp")
  messageCooldown     Int      @default(60) @map("message_cooldown")
  voiceCooldown       Int      @default(120) @map("voice_cooldown")
  levelFormula        String   @default("100 * level * 1.5") @map("level_formula")
  maxLevel            Int      @default(1000) @map("max_level")
  ignoredChannels     String   @default("[]") @map("ignored_channels")
  ignoredRoles        String   @default("[]") @map("ignored_roles")
  announcementChannelId String? @map("announcement_channel_id")
  announcementMessage String?  @map("announcement_message")
  xpCurve               String   @default("exponential") @map("xp_curve")
  xpMultiplier          Float    @default(1.0) @map("xp_multiplier")
  noXpRoles             String   @default("[]") @map("no_xp_roles")
  noXpChannels          String   @default("[]") @map("no_xp_channels")
  boosterRoles          String   @default("[]") @map("booster_roles")
  boosterChannels       String   @default("[]") @map("booster_channels")
  xpInThreads           Boolean  @default(true) @map("xp_in_threads")
  xpInForumPosts        Boolean  @default(true) @map("xp_in_forum_posts")
  xpVocalMessages       Boolean  @default(false) @map("xp_vocal_messages")
  showOtherLevels       Boolean  @default(true) @map("show_other_levels")
  resetOnLeave          Boolean  @default(false) @map("reset_on_leave")
  resetOnBan            Boolean  @default(false) @map("reset_on_ban")
  doubleXpLongMessages  Boolean  @default(false) @map("double_xp_long_messages")
  onlineLeaderboard     Boolean  @default(true) @map("online_leaderboard")
  discordLeaderboard    Boolean  @default(true) @map("discord_leaderboard")
  levelColor            String   @default("#14b8a6") @map("level_color")
  rewardAnnounce        Boolean  @default(true) @map("reward_announce")
  rewardMessage         String?  @map("reward_message")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  guild Guild @relation(fields: [guildId], references: [id])

  @@map("xp_settings")
}

/// Profil d'XP d'un utilisateur sur un serveur
model XPProfile {
  id                   String              @id @default(cuid()) @map("id")
  guildId              String              @map("guild_id")
  userId               String              @map("user_id")
  xp                   Int                 @default(0) @map("xp")
  level                Int                 @default(0) @map("level")
  voiceXp              Int                 @default(0) @map("voice_xp")
  messageCount         Int                 @default(0) @map("message_count")
  voiceMinutes         Int                 @default(0) @map("voice_minutes")
  lastMessageAt        DateTime?           @map("last_message_at")
  lastVoiceAt          DateTime?           @map("last_voice_at")
  levelUpNotification  LevelUpNotification @default(CHANNEL) @map("level_up_notification")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  guild Guild @relation(fields: [guildId], references: [id])
  user  User  @relation(fields: [userId], references: [discordId])

  @@unique([guildId, userId])
  @@index([guildId, xp])
  @@index([guildId, level])
  @@map("xp_profiles")
}

/// Récompense de rôle liée à un niveau
model XPRoleReward {
  id            String   @id @default(cuid()) @map("id")
  guildId       String   @map("guild_id")
  roleId        String   @map("role_id")
  levelRequired Int      @map("level_required")
  removeOnLevel Boolean  @default(false) @map("remove_on_level")
  xpMultiplier  Float    @default(1.0) @map("xp_multiplier")
  createdAt     DateTime @default(now()) @map("created_at")

