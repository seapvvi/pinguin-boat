/// Rôle dans un clan
enum ClanRole {
  OWNER
  OFFICER
  MEMBER
}

/// Statut d'une guerre de clans
enum ClanWarStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

/// Clan / équipe
model Clan {
  id          String   @id @default(cuid()) @map("id")
  guildId     String   @map("guild_id")
  name        String   @map("name")
  ownerId     String   @map("owner_id")
  description String?  @map("description")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  guild   Guild      @relation(fields: [guildId], references: [id])
  members ClanMember[]
  warsAsChallenger ClanWar[] @relation("ChallengerClan")
  warsAsOpponent   ClanWar[] @relation("OpponentClan")

  @@unique([guildId, name])
  @@index([guildId])
  @@map("clans")
}

/// Membre d'un clan
model ClanMember {
  id       String   @id @default(cuid()) @map("id")
  clanId   String   @map("clan_id")
  guildId  String   @map("guild_id")
  userId   String   @map("user_id")
  role     ClanRole @default(MEMBER) @map("role")
  joinedAt DateTime @default(now()) @map("joined_at")

  clan  Clan  @relation(fields: [clanId], references: [id], onDelete: Cascade)
  guild Guild @relation(fields: [guildId], references: [id])

  @@unique([guildId, userId])
  @@index([clanId])
  @@index([guildId, userId])
  @@map("clan_members")
}

/// Guerre entre deux clans
model ClanWar {
  id             String        @id @default(cuid()) @map("id")
  guildId        String        @map("guild_id")
  challengerId   String        @map("challenger_id")
  opponentId     String        @map("opponent_id")
  status         ClanWarStatus @default(PENDING) @map("status")
  startedAt      DateTime?     @map("started_at")
  endsAt         DateTime?     @map("ends_at")
  challengerXp   Int           @default(0) @map("challenger_xp")
  opponentXp     Int           @default(0) @map("opponent_xp")
  winnerId       String?       @map("winner_id")
  prizePool      Int           @default(0) @map("prize_pool")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  guild      Guild @relation(fields: [guildId], references: [id])
  challenger Clan  @relation("ChallengerClan", fields: [challengerId], references: [id])
  opponent   Clan  @relation("OpponentClan", fields: [opponentId], references: [id])

  @@index([guildId, status])
  @@index([challengerId])
  @@index([opponentId])
  @@map("clan_wars")
}

/// Paramètres du starboard pour un serveur
model StarboardSettings {
  id           String  @id @default(cuid()) @map("id")
  guildId      String  @unique @map("guild_id")
  enabled      Boolean @default(false) @map("enabled")
  channelId    String? @map("channel_id")
  starEmoji    String  @default("⭐") @map("star_emoji")
  minStars     Int     @default(3) @map("min_stars")
  selfStar     Boolean @default(false) @map("self_star")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  guild   Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  entries StarboardEntry[]

  @@map("starboard_settings")
}

/// Entrée du starboard
model StarboardEntry {
  id          String   @id @default(cuid()) @map("id")
  guildId     String   @map("guild_id")
  originalId  String   @map("original_id")
  starboardId String?  @unique @map("starboard_id")
  authorId    String   @map("author_id")
  starCount   Int      @default(0) @map("star_count")
  content     String   @map("content")
  attachment  String?  @map("attachment")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  settings StarboardSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, originalId])
  @@index([guildId, starCount])
  @@map("starboard_entries")
}

/// Paramètres des formulaires pour un serveur
model FormSettings {
  id          String  @id @default(cuid()) @map("id")
  guildId     String  @unique @map("guild_id")
  enabled     Boolean @default(false) @map("enabled")
  channelId   String? @map("channel_id")
  logChannel  String? @map("log_channel")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  guild       Guild          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  templates   FormTemplate[]
  submissions FormSubmission[]

  @@map("form_settings")
}

/// Modèle de formulaire personnalisé
model FormTemplate {
  id          String   @id @default(cuid()) @map("id")
  guildId     String   @map("guild_id")
  name        String   @map("name")
  description String?  @map("description")
  fields      String   @map("fields")
  enabled     Boolean  @default(true) @map("enabled")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  settings FormSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, enabled])
  @@map("form_templates")
}

/// Soumission de formulaire
model FormSubmission {
  id          String   @id @default(cuid()) @map("id")
  guildId     String   @map("guild_id")
  templateId  String   @map("template_id")
  userId      String   @map("user_id")
  responses   String   @map("responses")
  status      String   @default("pending") @map("status")
  reviewedBy  String?  @map("reviewed_by")
  reviewedAt  DateTime? @map("reviewed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  settings FormSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, status])
  @@index([templateId])
  @@map("form_submissions")
}

/// Suivi des invitations
model InviteTrack {
  id          String   @id @default(cuid()) @map("id")
  guildId     String   @map("guild_id")
  inviterId   String   @map("inviter_id")
  inviteCode  String   @map("invite_code")
  joinedId    String   @map("joined_id")
  joinedAt    DateTime @default(now()) @map("joined_at")
  isFake      Boolean  @default(false) @map("is_fake")
  hasLeft     Boolean  @default(false) @map("has_left")
  leftAt      DateTime? @map("left_at")

  @@index([guildId, inviterId])
  @@index([guildId, joinedId])
  @@index([inviterId])
  @@map("invite_tracks")
}

/// Sauvegarde des salons et rôles d'un serveur
model GuildBackup {
