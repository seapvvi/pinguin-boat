/// Déploiement
model Deployment {
  id            String             @id @default(cuid()) @map("id")
  version       String             @map("version")
  releasePath   String             @map("release_path")
  environment   DeployEnvironment  @default(DEVELOPMENT) @map("environment")
  // ^ Guard: environnement cible — production refuse les branches non autorisées
  gitRef        String?            @map("git_ref")
  // ^ Commit SHA déployé (traçabilité, rollback précis)
  status        DeploymentStatus   @default(PENDING) @map("status")
  log           String?            @map("log")
  triggeredById String             @map("triggered_by_id")
  createdAt     DateTime           @default(now()) @map("created_at")
  startedAt     DateTime           @default(now()) @map("started_at")
  completedAt   DateTime?          @map("completed_at")

  releases DeploymentRelease[]

  @@index([createdAt])
  @@index([status])
  @@index([environment])
  @@map("deployments")
}

/// Version de déploiement précédente (pour rollback)
model DeploymentRelease {
  id           String           @id @default(cuid()) @map("id")
  version      String           @map("version")
  releasePath  String           @map("release_path")
  deploymentId String?          @map("deployment_id")
  status       DeploymentStatus @map("status")
  createdAt    DateTime         @default(now()) @map("created_at")

  deployment Deployment? @relation(fields: [deploymentId], references: [id])

  @@index([createdAt])
