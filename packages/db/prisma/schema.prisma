}

/// Fenêtre de maintenance planifiée
model MaintenanceWindow {
  id        String   @id @default(cuid()) @map("id")
  message   String   @map("message")
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
