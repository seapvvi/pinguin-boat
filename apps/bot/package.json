    "@pinguin/shared": "workspace:*",
    "discord.js": "^14.17.3",
    "ffmpeg-static": "^5.2.0",
    "opusscript": "^0.1.1",
    "play-dl": "^1.9.7",
    "sodium-native": "^4.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
