    "@fastify/csrf-protection": "^8.0.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/websocket": "^11.0.1",
    "@pinguin/config": "workspace:*",
    "@pinguin/db": "workspace:*",
    "@pinguin/shared": "workspace:*",
    "bcrypt": "^6.0.0",
    "fastify": "^5.2.0",
    "qrcode": "^1.5.4",
    "simple-git": "^3.27.0",
    "speakeasy": "^2.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
