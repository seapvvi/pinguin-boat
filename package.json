{
  "name": "pinguin-boat",
  "version": "0.1.0-alpha",
  "private": true,
  "description": "Pinguin BOAT - Forgé pour la communauté",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo run dev",
    "dev:preload": "node scripts/dev-with-preload.js",
    "build": "turbo run build",
    "lint": "eslint apps/**/src/**/*.ts packages/**/*.ts",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "kill-ports": "bash scripts/force-kill-ports.sh",
    "dev:clean": "bash scripts/force-kill-ports.sh && pnpm dev",
    "db:generate": "pnpm --filter @pinguin/db db:generate",
    "db:push": "pnpm --filter @pinguin/db db:push",
    "db:migrate": "pnpm --filter @pinguin/db db:migrate",
    "db:migrate:prod": "pnpm --filter @pinguin/db db:migrate:prod",
    "db:studio": "pnpm --filter @pinguin/db db:studio",
    "db:seed": "pnpm --filter @pinguin/db db:seed",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.4.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
