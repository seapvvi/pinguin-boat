# ─────────────────────────────────────────────
# Pinguin BOAT - Configuration d'environnement
# ─────────────────────────────────────────────
# Copier ce fichier en .env et remplir les valeurs

# ── Discord ──
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_TOKEN=
DISCORD_OWNER_ID=
DISCORD_PUBLIC_KEY=
DISCORD_SUPPORT_INVITE=https://discord.gg/example

# ── Base de données ──
DATABASE_URL=postgresql://pinguin:password@localhost:5432/pinguinboat

# ── Session ──
SESSION_SECRET=
SESSION_MAX_AGE=604800

# ── API ──
API_HOST=0.0.0.0
API_PORT=4000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000
API_INTERNAL_PORT=3004
NODE_ENV=development

# ── Web (Next.js) ──
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DISCORD_CLIENT_ID=your_discord_client_id_here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Bot ──
BOT_ACTIVITY_TYPE=3
BOT_ACTIVITY_NAME=🏔️ Pinguin BOAT | /help
BOT_INTERNAL_URL=http://127.0.0.1:3003
BOT_INTERNAL_SECRET=changeme_generate_a_random_32char_string

# ── YouTube / Music ──
# YOUTUBE_COOKIE: Cookie d'authentification YouTube (optionnel, évite les restrictions 429).
# Obtenez-le depuis votre navigateur : ouvrez youtube.com, DevTools → Application → Cookies
# Copiez la chaîne complète du cookie (ex: "LOGIN_INFO=xxx; SID=xxx; ...")
# Laissez vide si vous n'avez pas de cookie — yt-dlp fonctionnera sans.
YOUTUBE_COOKIE=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SOUNDCLOUD_CLIENT_ID=

# ── Discord Dev ──
# ID de votre serveur de test Discord pour un déploiement instantané des commandes.
# En développement, les commandes sont enregistrées sur cette guild (instantané)
# au lieu d'être globales (jusqu'à 1h de propagation).
DISCORD_DEV_GUILD_ID=

# ── GitHub ──
GITHUB_REPO=seapvvi/pinguin-boat
GITHUB_BRANCH=master
# Optionnel, nécessaire si repo privé
GITHUB_TOKEN=

# ── Owner ──
# Mot de passe en clair pour la page owner dashboard
# Le hachage (bcrypt) est géré automatiquement par le serveur au démarrage
OWNER_PASSWORD=your_secure_password_here
OWNER_WEBHOOK_URL=

# ── Deploiement ──
DEPLOY_PATH=/opt/pinguinboat
DEPLOY_RELEASES_PATH=/opt/pinguinboat/releases
DEPLOY_SHARED_PATH=/opt/pinguinboat/shared
DEPLOY_BACKUPS_PATH=/opt/pinguinboat/backups
DEPLOY_CURRENT_LINK=/opt/pinguinboat/current

# ── Pastebin ──
# Optionnel, pour les transcriptions de tickets
PASTEBIN_API_KEY=

# ── Module Notifications (Twitch) ──
# Optionnel
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Module Notifications (YouTube) ──
# Optionnel
YOUTUBE_API_KEY=

# ── Feature Flags ──
ALPHA_ALL_FREE=true
PREMIUM_ENABLED=false

# ── Logging ──
LOG_LEVEL=debug
LOG_FORMAT=pretty