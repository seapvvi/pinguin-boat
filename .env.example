# ─────────────────────────────────────────────
# Pinguin BOAT - Configuration d'environnement
# ─────────────────────────────────────────────
# Copier ce fichier en .env et remplir les valeurs

# ── Discord ──
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_TOKEN=
DISCORD_OWNER_ID=
DISCORD_PUBLIC_KEY=

# ── Base de données ──
DATABASE_URL=postgresql://pinguin:password@localhost:5432/pinguinboat

# ── Session ──
SESSION_SECRET=
SESSION_MAX_AGE=604800

# ── API ──
API_HOST=0.0.0.0
API_PORT=4000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# ── Web (Next.js) ──
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DISCORD_CLIENT_ID=1506745561917816842
NEXT_PUBLIC_DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Bot ──
BOT_ACTIVITY_TYPE=3
BOT_ACTIVITY_NAME=🏔️ Pinguin BOAT | /help
BOT_INTERNAL_URL=http://127.0.0.1:3002
BOT_INTERNAL_SECRET= (obligatoire en production, changer la valeur)

# ── YouTube / Music ──
# YOUTUBE_COOKIE: Cookie d'authentification YouTube (optionnel, évite les restrictions 429).
# Obtenez-le depuis votre navigateur : ouvrez youtube.com, DevTools → Application → Cookies → yt.conn ou LOGIN_INFO.
YOUTUBE_COOKIE= (optionnel)
SPOTIFY_CLIENT_ID= (optionnel)
SPOTIFY_CLIENT_SECRET= (optionnel)
SOUNDCLOUD_CLIENT_ID= (optionnel)

# ── GitHub ──
GITHUB_REPO=seapvvi/pinguin-boat
GITHUB_BRANCH=master
GITHUB_TOKEN= (optionnel, nécessaire si repo privé)

# ── Deploiement ──
DEPLOY_PATH=/opt/pinguinboat
DEPLOY_RELEASES_PATH=/opt/pinguinboat/releases
DEPLOY_SHARED_PATH=/opt/pinguinboat/shared
DEPLOY_BACKUPS_PATH=/opt/pinguinboat/backups
DEPLOY_CURRENT_LINK=/opt/pinguinboat/current

# ── Pastebin ──
PASTEBIN_API_KEY= (optionnel, pour les transcriptions de tickets)

# ── Feature Flags ──
ALPHA_ALL_FREE=true
PREMIUM_ENABLED=false

# ── Logging ──
LOG_LEVEL=debug
LOG_FORMAT=pretty